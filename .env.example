APP_NAME=Hari_Santri_2026_Event_Portal
APP_ENV=development
APP_DEBUG=true
API_PREFIX=/api/v1
CORS_ENABLED=TRUE
# Set CORS_ENABLED=FALSE in production when nginx handles the same-origin setup.

DATABASE_URL=postgresql+asyncpg://openpg:openpgpwd@localhost:5432/hari_santri
APP_SECRET_KEY=change_me
JWT_SECRET_KEY=change_me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

FRONTEND_URL=http://localhost:3000
FRONTEND_LOGIN_URL=http://localhost:3000/login
FRONTEND_RESET_PASSWORD_URL=http://localhost:3000/reset-password
PASSWORD_RESET_EXPIRE_MINUTES=30

# Titan Email SMTP for transactional email (port 465 uses implicit SSL/TLS)
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=smtp.titan.email
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USE_SSL=true
EMAIL_SMTP_USE_TLS=false
EMAIL_SMTP_USERNAME=event@iwbif.id
EMAIL_SMTP_PASSWORD=Iwbif2026@@
EMAIL_FROM_ADDRESS=event@iwbif.id
EMAIL_FROM_NAME=IWBIF 2026

PROJECT_TIMEZONE=Asia/Jakarta
PUBLIC_BASE_URL=http://localhost:8000

# DOKU Checkout (use Back Office credentials; never expose these to frontend)
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_BASE_URL=https://api-sandbox.doku.com
DOKU_CHECKOUT_PATH=/checkout/v1/payment
DOKU_PAYMENT_DUE_MINUTES=60
DOKU_NOTIFICATION_PATH=/api/v1/webhooks/doku
DOKU_NOTIFICATION_BASE_URL=
DOKU_CALLBACK_URL=http://localhost:3000/payment/result

# Midtrans Snap (use sandbox keys first; never expose SERVER_KEY to frontend)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_PAYMENT_DUE_MINUTES=60
MIDTRANS_CALLBACK_URL=http://localhost:3000/payment/result

# DOKU Direct API SNAP (do not commit real credentials/private keys)
DOKU_SNAP_PARTNER_ID=
DOKU_SNAP_CLIENT_SECRET=
DOKU_SNAP_PRIVATE_KEY_PATH=.secrets/doku-snap-private.pem
DOKU_SNAP_DOKU_PUBLIC_KEY_PATH=.secrets/doku-snap-public.pem
DOKU_SNAP_DOKU_CLIENT_ID=
# Map bank code to left-padded SNAP partnerServiceId and customer prefix, e.g. {"BCA":{"partner_service_id":"   19008","customer_no":"9"}}
DOKU_SNAP_VA_CHANNELS_JSON={}
DOKU_SNAP_CHANNEL_ID=H2H
DOKU_SNAP_TOKEN_PATH=/authorization/v1/access-token/b2b
DOKU_SNAP_VA_CREATE_PATH=/virtual-accounts/bi-snap-va/v1.1/transfer-va/create-va
DOKU_SNAP_MERCHANT_TOKEN_PATH=/api/v1/doku/snap/authorization/v1/access-token/b2b
DOKU_SNAP_VA_NOTIFICATION_PATH=/api/v1/webhooks/doku/snap/va/payment
DOKU_QRIS_MERCHANT_ID=
DOKU_QRIS_TERMINAL_ID=
DOKU_SNAP_QRIS_GENERATE_PATH=/snap-adapter/b2b/v1.0/qr/qr-mpm-generate
DOKU_SNAP_QRIS_NOTIFICATION_PATH=/api/v1/webhooks/doku/snap/qris/payment
DOKU_SNAP_EWALLET_AUTHORIZATION_RETURN_PATH=/api/v1/payments/doku/snap/e-wallet/authorization/return
DOKU_SNAP_EWALLET_NOTIFICATION_PATH=/api/v1/webhooks/doku/snap/e-wallet/payment
DOKU_SNAP_EWALLET_CHANNELS_JSON={"DANA":{"channel":"EMONEY_DANA_SNAP","consumer_key":"","consumer_secret":""},"SHOPEEPAY":{"channel":"EMONEY_SHOPEEPAY_SNAP","consumer_key":"","consumer_secret":""},"OVO":{"channel":"EMONEY_OVO_SNAP","consumer_key":"","consumer_secret":""}}
# Per-channel SNAP Direct Debit credentials. Insert real credentials only in
# the deployment secret manager / untracked production .env file.
DOKU_SNAP_DIRECT_DEBIT_BINDING_RETURN_PATH=/api/v1/payments/doku/snap/direct-debit/binding/return
DOKU_SNAP_DIRECT_DEBIT_NOTIFICATION_PATH=/api/v1/webhooks/doku/snap/direct-debit/payment
DOKU_SNAP_DIRECT_DEBIT_CHANNELS_JSON={"CIMB":{"channel":"DIRECT_DEBIT_CIMB_SNAP","consumer_key":"","consumer_secret":"","merchant_id":""},"BRI":{"channel":"DIRECT_DEBIT_BRI_SNAP","consumer_key":"","consumer_secret":""},"MANDIRI":{"channel":"DIRECT_DEBIT_MANDIRI_SNAP","consumer_key":"","consumer_secret":"","merchant_id":"","terminal_id":""},"ALLO":{"channel":"DIRECT_DEBIT_ALLO_SNAP","consumer_key":"","consumer_secret":"","merchant_id":""}}
DOKU_SNAP_TOKEN_TTL_SECONDS=900
DOKU_SNAP_TIMESTAMP_TOLERANCE_SECONDS=300

# Server-to-server Payment Portal integration. Never expose these values to Nuxt.
PAYMENT_PORTAL_BASE_URL=
PAYMENT_PORTAL_CLIENT_ID=
PAYMENT_PORTAL_CLIENT_SECRET=
PAYMENT_PORTAL_CALLBACK_SECRET=
PAYMENT_PORTAL_SERVICE_CODE=HARI_SANTRI_2026
PAYMENT_PORTAL_RETURN_URL=http://localhost:3000/pembayaran/hasil
PAYMENT_PORTAL_TIMEOUT_SECONDS=15
PAYMENT_PORTAL_CALLBACK_TOLERANCE_SECONDS=300
