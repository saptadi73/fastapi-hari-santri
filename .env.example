APP_NAME=Hari_Santri_2026_Event_Portal
APP_ENV=development
APP_DEBUG=true
API_PREFIX=/api/v1
CORS_ENABLED=TRUE
# Set CORS_ENABLED=FALSE in production when nginx handles the same-origin setup.

DATABASE_URL=postgresql+asyncpg://openpg:openpgpwd@localhost:5432/hari_santri
APP_SECRET_KEY=change_me
JWT_SECRET_KEY=change_me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

FRONTEND_URL=http://localhost:3000
FRONTEND_LOGIN_URL=http://localhost:3000/login
FRONTEND_RESET_PASSWORD_URL=http://localhost:3000/reset-password
PASSWORD_RESET_EXPIRE_MINUTES=30

# Titan Email SMTP for transactional email (port 465 uses implicit SSL/TLS)
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=smtp.titan.email
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USE_SSL=true
EMAIL_SMTP_USE_TLS=false
EMAIL_SMTP_USERNAME=event@iwbif.id
EMAIL_SMTP_PASSWORD=Iwbif2026@@
EMAIL_FROM_ADDRESS=event@iwbif.id
EMAIL_FROM_NAME=IWBIF 2026

PROJECT_TIMEZONE=Asia/Jakarta
PUBLIC_BASE_URL=http://localhost:8000
VOUCHER_SCAN_RATE_LIMIT_PER_MINUTE=30
VOUCHER_SCAN_RATE_LIMIT_WINDOW_SECONDS=60

# Server-to-server Payment Portal integration. Never expose these values to Nuxt.
PAYMENT_PORTAL_BASE_URL=
PAYMENT_PORTAL_CLIENT_ID=
PAYMENT_PORTAL_CLIENT_SECRET=
PAYMENT_PORTAL_CALLBACK_SECRET=
PAYMENT_PORTAL_SERVICE_CODE=HARI_SANTRI_2026
PAYMENT_PORTAL_RETURN_URL=http://localhost:3000/pembayaran/hasil
PAYMENT_PORTAL_TIMEOUT_SECONDS=15
PAYMENT_PORTAL_CALLBACK_TOLERANCE_SECONDS=300
